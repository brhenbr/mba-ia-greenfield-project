{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testTimeout": 60000,
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["dotenv/config", "<rootDir>/set-test-env.ts"],
  "globalSetup": "<rootDir>/jest-global-setup.ts"
}
