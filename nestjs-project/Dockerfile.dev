# Static FFmpeg 7.1 binaries. The API never calls them at runtime; they are here
# so the e2e suite can run the video worker in-process
# (test/video-processing.e2e-spec.ts). The Debian package would be FFmpeg 5.x.
FROM mwader/static-ffmpeg:7.1 AS ffmpeg

FROM node:25.6.0-slim

COPY --from=ffmpeg /ffmpeg /ffprobe /usr/local/bin/

RUN apt update && apt install -y procps curl

WORKDIR /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ]
