# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO, S3-compatible)
# S3_ENDPOINT is the internal Compose service name. S3_PUBLIC_ENDPOINT is the host
# baked into presigned URLs used by clients outside the Docker network — the only
# permitted use of localhost (the signature binds the Host header).
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=streamtube
S3_SECRET_ACCESS_KEY=streamtube-secret
S3_BUCKET=streamtube-videos
S3_PRESIGN_EXPIRES_SECONDS=3600

# Queue (Redis + BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_PREFIX=streamtube

# Videos
VIDEO_PART_SIZE_BYTES=67108864
VIDEO_WORKER_CONCURRENCY=4
VIDEO_MAX_OPEN_DRAFTS=20
VIDEO_SWEEP_INTERVAL_MS=300000
VIDEO_PROCESSING_STUCK_MINUTES=30
VIDEO_DRAFT_TTL_DAYS=2
